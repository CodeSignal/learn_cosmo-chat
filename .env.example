# ── Backend selection ──────────────────────────────────────────
# Courses choose the backend in chat-config.json:
#   "useBedrock": true   → Amazon Bedrock (AWS-only course)
#   omitted / false      → Octavus (default for existing courses)
#
# Fill in the credentials for whichever backend that course uses.

# ── Octavus (default) ──────────────────────────────────────────
OCTAVUS_API_URL=https://octavus.ai
OCTAVUS_API_KEY=oct_sk_your_key_here

# Deployed agent IDs for each target (find them with: npx octavus --env .env list)
OCTAVUS_AGENT_ID_DEV=your_dev_agent_id
OCTAVUS_AGENT_ID_PROD=your_prod_agent_id

# Which agent npm run start / npm run start:prod talk to (npm run dev forces "dev")
AGENT_TARGET=prod

# Legacy single-agent fallback (used when the target-specific ID above is missing)
# OCTAVUS_AGENT_ID=your_agent_id

# ── Amazon Bedrock (only when chat-config has "useBedrock": true) ──
# Prefixed so this app can use a dedicated Bedrock principal without clashing
# with the standard AWS_* variables used by other tooling on the same machine.
BEDROCK_AWS_ACCESS_KEY_ID=AKIA...
BEDROCK_AWS_SECRET_ACCESS_KEY=your_secret_here

# Only needed when using temporary (STS) credentials.
# BEDROCK_AWS_SESSION_TOKEN=

# Region the Bedrock runtime endpoint is called in.
BEDROCK_AWS_REGION=us-east-1

# Set to true to authenticate with the default AWS provider chain (EC2/ECS role,
# SSO, ~/.aws profile) instead of the keys above.
# BEDROCK_AWS_USE_DEFAULT_CREDENTIALS=true

# Optional: HTTP port (default 3000)
# PORT=3000
